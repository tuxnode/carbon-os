#!/bin/sh
# CarbonOS early userspace init (PID 1, via rdinit=/sbin/init)

# Mount a virtual filesystem if the mount tool is available.
mount_fs() {
	command -v mount >/dev/null 2>&1 || return 0
	mkdir -p "$3"
	mount -t "$1" "$2" "$3"
}

mount_fs proc     none /proc
mount_fs sysfs    none /sys
mount_fs devtmpfs none /dev
mount_fs devpts   none /dev/pts
mount_fs tmpfs    none /tmp
mount_fs tmpfs    none /run

if command -v hostname >/dev/null 2>&1; then
	hostname carbonos
fi

echo 0 > /proc/sys/kernel/hung_task_timeout_secs 2>/dev/null || true

echo "========================================================"
echo "      Welcome to CarbonOS (RISC-V 64 / Musl / Rust)     "
echo "        Terminal-First Immutable Linux System           "
echo "========================================================"
echo ""

# Hand off to an interactive shell once one is available.
if [ -x /bin/sh ]; then
	exec /bin/sh
fi
