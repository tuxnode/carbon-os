[submodule "vendor/linux"]
	path = vendor/linux
	url = https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
[submodule "vendor/uutils"]
	path = vendor/uutils
	url = https://github.com/uutils/coreutils.git
[submodule "vendor/musl"]
	path = vendor/musl
	url = https://git.musl-libc.org/git/musl
[submodule "vendor/brush"]
	path = vendor/brush
	url = https://github.com/reubeno/brush.git
