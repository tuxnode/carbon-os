TARGET_ARCH  := @TARGET_ARCH@
RUST_TARGET  := @RUST_TARGET@
ENABLE_EROFS := @ENABLE_EROFS@
CC           := @CC@
LLD          := @LLD@
LLVM_AR      := @LLVM_AR@
LLVM_RANLIB  := @LLVM_RANLIB@

PROJECT_ROOT := $(shell pwd)
BUILD_DIR    := $(PROJECT_ROOT)/build
ROOTFS_DIR   := $(BUILD_DIR)/rootfs
KERNEL_SRC   := $(PROJECT_ROOT)/vendor/linux
MUSL_SRC     := $(PROJECT_ROOT)/vendor/musl
UUTILS_SRC   := $(PROJECT_ROOT)/vendor/uutils
BRUSH_SRC    := $(PROJECT_ROOT)/vendor/brush
INIT_DIR     := $(PROJECT_ROOT)/init
SYSROOT_DIR  := $(BUILD_DIR)/sysroot

.PHONY: all kernel musl userland brush init rootfs run-qemu clean distclean

all: kernel userland brush init rootfs
	@echo "===================================================="
	@echo " CarbonOS ($(TARGET_ARCH)) Build Complete!"
	@echo " Output directory: $(BUILD_DIR)/"
	@echo " Run 'make run-qemu' to test in simulator."
	@echo "===================================================="

# linux
kernel:
	@echo "==> Building Linux Kernel ($(TARGET_ARCH))..."
	@mkdir -p $(BUILD_DIR)
	@if [ ! -f $(KERNEL_SRC)/.config ]; then \
		echo "    Generating default kernel config..."; \
		$(MAKE) -C $(KERNEL_SRC) ARCH=riscv LLVM=1 defconfig; \
	fi
	$(MAKE) -C $(KERNEL_SRC) ARCH=riscv LLVM=1 -j$$(nproc) Image
	cp $(KERNEL_SRC)/arch/riscv/boot/Image $(BUILD_DIR)/Image

# musl libc (static sysroot; host LLVM lacks a riscv64 compiler-rt, so no shared libs)
musl:
	@echo "==> Cross-compiling Musl libc (C) for $(TARGET_ARCH)..."
	@mkdir -p $(SYSROOT_DIR)
	@if [ ! -f $(MUSL_SRC)/config.mak ]; then \
		cd $(MUSL_SRC) && ./configure \
			--target=riscv64-linux-musl \
			--disable-shared \
			--prefix=$(SYSROOT_DIR)/usr \
			CC="$(CC) --target=riscv64-unknown-linux-musl -fuse-ld=lld" \
			AR="$(LLVM_AR)" \
			RANLIB="$(LLVM_RANLIB)"; \
	fi
	$(MAKE) -C $(MUSL_SRC) -j$$(nproc)
	$(MAKE) -C $(MUSL_SRC) install

# uutils coreutils
userland: musl
	@echo "==> Building Rust uutils/coreutils ($(RUST_TARGET))..."
	cd $(UUTILS_SRC) && \
		CC_riscv64gc_unknown_linux_musl="$(CC) --target=riscv64-unknown-linux-musl --sysroot=$(SYSROOT_DIR)" \
		AR_riscv64gc_unknown_linux_musl="$(LLVM_AR)" \
		CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_LINKER="$(LLD)" \
		BINDGEN_EXTRA_CLANG_ARGS="--target=riscv64-unknown-linux-musl --sysroot=$(SYSROOT_DIR)" \
		cargo build --release --target $(RUST_TARGET) \
		--features feat_Tier1,feat_require_unix_musl

# brush shell (Rust, POSIX/bash compatible)
brush: musl
	@echo "==> Building Rust brush shell ($(RUST_TARGET))..."
	cd $(BRUSH_SRC) && \
		CC_riscv64gc_unknown_linux_musl="$(CC) --target=riscv64-unknown-linux-musl --sysroot=$(SYSROOT_DIR)" \
		AR_riscv64gc_unknown_linux_musl="$(LLVM_AR)" \
		CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_LINKER="$(LLD)" \
		CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static" \
		cargo build --release --target $(RUST_TARGET) -p brush-shell

# CarbonOS init (PID 1)
init:
	@echo "==> Building CarbonOS init ($(RUST_TARGET))..."
	cd $(INIT_DIR) && \
		CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_LINKER="$(LLD)" \
		CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static" \
		cargo build --release --target $(RUST_TARGET)

# rootfs
rootfs: userland brush init
	@echo "==> Assembling Rootfs..."
	rm -rf $(ROOTFS_DIR)
	mkdir -p $(ROOTFS_DIR)/bin $(ROOTFS_DIR)/sbin $(ROOTFS_DIR)/etc/init.d \
		$(ROOTFS_DIR)/proc $(ROOTFS_DIR)/sys $(ROOTFS_DIR)/dev $(ROOTFS_DIR)/tmp $(ROOTFS_DIR)/root
	cp -r overlay/* $(ROOTFS_DIR)/
	
	@echo "==> Installing uutils/coreutils binary..."
	@if [ -f $(UUTILS_SRC)/target/$(RUST_TARGET)/release/coreutils ]; then \
		cp $(UUTILS_SRC)/target/$(RUST_TARGET)/release/coreutils $(ROOTFS_DIR)/bin/coreutils; \
	elif [ -f $(UUTILS_SRC)/target/$(RUST_TARGET)/release/uutils ]; then \
		cp $(UUTILS_SRC)/target/$(RUST_TARGET)/release/uutils $(ROOTFS_DIR)/bin/coreutils; \
	else \
		echo "Error: Could not find compiled coreutils binary in $(UUTILS_SRC)/target/$(RUST_TARGET)/release/"; \
		exit 1; \
	fi
	
	@echo "==> Creating coreutils applet symlinks..."
	@UTILS_MAP=$$(ls -t $(UUTILS_SRC)/target/$(RUST_TARGET)/release/build/coreutils-*/out/uutils_map.rs 2>/dev/null | head -n1); \
	if [ -z "$$UTILS_MAP" ]; then \
		echo "Error: could not locate uutils_map.rs to derive applet names"; \
		exit 1; \
	fi; \
	for util in $$(sed -n 's/^[[:space:]]*("\([^"]*\)".*/\1/p' "$$UTILS_MAP"); do \
		ln -sf coreutils $(ROOTFS_DIR)/bin/"$$util"; \
	done

	@echo "==> Installing brush shell..."
	@if [ -f $(BRUSH_SRC)/target/$(RUST_TARGET)/release/brush ]; then \
		cp $(BRUSH_SRC)/target/$(RUST_TARGET)/release/brush $(ROOTFS_DIR)/bin/brush; \
		ln -sf brush $(ROOTFS_DIR)/bin/sh; \
	else \
		echo "Error: Could not find compiled brush binary in $(BRUSH_SRC)/target/$(RUST_TARGET)/release/"; \
		exit 1; \
	fi

	@echo "==> Installing init (/sbin/init)..."
	cp $(INIT_DIR)/target/$(RUST_TARGET)/release/carbonos-init $(ROOTFS_DIR)/sbin/init
	chmod +x $(ROOTFS_DIR)/sbin/init
	
	@echo "==> Packing Initramfs (cpio)..."
	cd $(ROOTFS_DIR) && find . | cpio -o -H newc | gzip -9 > $(BUILD_DIR)/rootfs.cpio.gz
	@if [ "$(ENABLE_EROFS)" = "yes" ]; then \
		echo "==> Packing EROFS Image..."; \
		mkfs.erofs -z lz4hc $(BUILD_DIR)/rootfs.erofs $(ROOTFS_DIR); \
	fi

run-qemu:
	@echo "==> Launching CarbonOS (riscv64) in QEMU..."
	qemu-system-riscv64 \
		-M virt \
		-cpu rv64 \
		-m 512M \
		-nographic \
		-kernel $(BUILD_DIR)/Image \
		-initrd $(BUILD_DIR)/rootfs.cpio.gz \
		-append "console=ttyS0 rdinit=/sbin/init quiet"

clean:
	rm -rf $(BUILD_DIR)

distclean: clean
	rm -f Makefile config.status config.log
